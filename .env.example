# Copiaza acest fisier in .env (comanda: docker compose config il citeste automat)
# Secreturile sunt generate o singura data la prima rulare. Nu schimba POSTGRES_PASSWORD si JWT_SECRET dupa prima pornire.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=<24 byte-uri baz64, ex. rezultat din node randomBytes>
JWT_SECRET=<48 byte-uri, ex. din crypto randomBytes base64>
JWT_EXPIRY=3600
PG_META_CRYPTO_KEY=<36 byte-uri baz64>
# Chei JWT semnate cu HS256 folosind JWT_SECRET (role: anon / service_role, exp > 2036):
ANON_KEY=<jwt anon>
SERVICE_ROLE_KEY=<jwt service role>

# URL-urile la care BROWSERUL clientului poate ajunge.
# Local: localhost. Pe server: pune adresa publica (http://<ip-servidor>:port)
# ca sa functioneze comanda si statusul de pe telefon.
PUBLIC_REST_URL=http://localhost:3002
PUBLIC_STORAGE_URL=http://localhost:5000

# Porturile publicate pe host
APP_PORT=3000
REST_PORT=3002
STORAGE_PORT=5000
STUDIO_PORT=8080
