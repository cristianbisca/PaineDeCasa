# Acest fisier e doar exemplu. Genereaza valorile reale cu:
#   node tools/generate-secrets.mjs --domain https://<domeniu>   (pe server)
#   node tools/generate-secrets.mjs                              (local)
# Nu schimba POSTGRES_PASSWORD, JWT_SECRET, PG_META_CRYPTO_KEY dupa prima pornire.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=<generat>
JWT_SECRET=<generat>
JWT_EXPIRY=3600
PG_META_CRYPTO_KEY=<generat>
# Chei JWT semnate HS256 cu JWT_SECRET (exp ~10 ani):
ANON_KEY=<generat>
SERVICE_ROLE_KEY=<generat>

# URL-urile la care BROWSERUL clientului poate ajunge.
# Local: localhost + port. Cu nginx: un singur domeniu cu sufixe,
# ex. https://paine.example.ro/rest  si  https://paine.example.ro/storage
PUBLIC_REST_URL=http://localhost:3002
PUBLIC_STORAGE_URL=http://localhost:5000

# Porturile publicate pe host (nginx vorbeste cu ele pe 127.0.0.1)
APP_PORT=3000
REST_PORT=3002
STORAGE_PORT=5000
STUDIO_PORT=8080
